# ── Cloudflare Tunnel (optional) ─────────────────────────────────────────────
# Leave both unset to disable the tunnel entirely (cloudflared stays installed
# but idle). TUNNEL_ONLY only takes effect when TUNNEL_TOKEN is also set.
TUNNEL_TOKEN=
TUNNEL_ONLY=false

# ── SINGBOX ────────────────────────────────────────────────────────────────────
SINGBOX_VERSION=1.13.16

# ── OmniRoute ────────────────────────────────────────────────────────────────
# Production Compose image (published by .github/workflows/docker-build.yml).
# Leave unset to use ghcr.io/borhandarabi/ai-gateway:latest.
AI_GATEWAY_IMAGE=

# OmniRoute now runs as its OWN container (see docker-compose.yml's separate
# "omniroute" service + omniroute/Dockerfile) -- these vars configure THAT
# container, not ai-gateway.
OMNIROUTE_IMAGE=diegosouzapw/omniroute:3.8.50
OMNIROUTE_PORT=20128
# JWT_SECRET / API_KEY_SECRET: generate once (e.g. `openssl rand -hex 32`)
# and never change afterwards -- changing either invalidates every existing
# session and API key. Leaving them unset fails the compose up on purpose.
OMNIROUTE_JWT_SECRET=
OMNIROUTE_API_KEY_SECRET=
# First-login dashboard password; change it under Configuration -> Security
# after logging in once. Leave blank to let OmniRoute generate one (check
# the container logs for it on first start).
OMNIROUTE_INITIAL_PASSWORD=
OMNIROUTE_REQUIRE_API_KEY=true
# Kept for ai-gateway's own outbound-proxy service list (Settings ->
# Services); only meaningful if you point OmniRoute's own outbound proxy at
# ai-gateway's sing-box mixed-port -- optional, unrelated to the port above.
OMNIROUTE_PROXY_PORT=20129
# The two below are the odd ones out in this block -- they configure
# ai-gateway's SIDE of the "Add to OmniRoute" button in its own dashboard
# (Active services table), i.e. how ai-gateway calls OUT to the omniroute
# container above, not the omniroute container itself.
# OMNIROUTE_BASE_URL: matches the compose service name/port above by default;
# only change it if you point ai-gateway at an OmniRoute instance running
# somewhere else entirely.
OMNIROUTE_BASE_URL=http://omniroute:20128
# A management-scoped API key from OmniRoute's own dashboard: API Keys ->
# Create -> enable the "manage" scope. Required for the "Add to OmniRoute"
# button to work at all -- without it, ai-gateway has no way to authenticate
# to OmniRoute's provider-management API.
OMNIROUTE_MANAGEMENT_API_KEY=
# Where OmniRoute should reach THIS container to call a service back --
# used only to prefill the "Add to OmniRoute" form's Base URL field
# (<this>:<service port>/v1), never hardcoded in code. Defaults to the
# compose service name below; on Railway set this to
# http://ai-gateway.railway.internal instead if ai-gateway is deployed as a
# separate Railway service in the same project.
AI_GATEWAY_INTERNAL_BASE_URL=http://ai-gateway

# ── ZenFreeAPI (OpenCode Zen OpenAI-compatible proxy) ─────────────────────────
ZENFREEAPI_PORT=3008
ZENFREEAPI_PROXY_PORT=2008
ZENFREEAPI_REPO=https://github.com/izaart95-jpg/ZenFreeAPI.git#main
OPENCODE_ZEN_BASE=https://opencode.ai/zen/v1
OPENCODE_API_KEY=public
OPENCODE_CLIENT=cli
OPENCODE_USER_AGENT=opencode/0.0.0
ZEN_STATE_DIR=/data/zenfreeapi

# ── MimoApi ──────────────────────────────────────────────────────────────────
MIMO_PORT=3003
# Client-facing bearer key for mimo-ai-proxy's own /v1/chat/completions
# (its internal/middleware/auth.go only enforces this when non-empty).
# Blank by default -- same "open unless configured" default as most other
# services here.
MIMO_API_KEY=

# ── KimiApi ──────────────────────────────────────────────────────────────────
KIMI_PORT=3002
KIMI_ACCESS_TOKEN=
KIMI_AUTH_KEY=Waguri

# ── DeepSeekApi ───────────────────────────────────────────────────────────────
DEEPSEEK_PORT=3005
DEEPSEEK_TOKEN=Waguri

# ── zai / GlmApi ─────────────────────────────────────────────────────────────
ZAI_PORT=3001
ZAI_AUTH_TOKEN=Waguri
ZAI_TIMEOUT=300000
ZAI_TOKEN=
ZAI_AGENT_MODE=true
ZAI_LOG_LEVEL=info
ZAI_LOG_FORMAT=text

# ── grok2api-go ──────────────────────────────────────────────────────────────
GROK2API_PORT=3004
TZ=Asia/Shanghai
# GROK2API_CONFIG_SOURCE defaults to /data/grok2api/config.yaml (see s6-rc.d/grok2api/run)

# ── sing-box ──────────────────────────────────────────────────────────────────
CLASH_API_PORT=9090
MIXED_PORT=7890

# ── General Reverse Proxy ─────────────────────────────────────────────────────
PROXY_PORT=80

# ── build-time source pins (used by docker-compose.yml / GH Actions) ────────
MIMO_REPO=https://github.com/hooshidev3/mimo-ai-proxy.git#main

GROK2API_REPO=https://github.com/chenyme/grok2api.git#main
ZAI_REPO=https://github.com/borhandarabi/GLM-Free-API.git#main
KIMI_REPO=https://github.com/izaart95-jpg/KimiFreeAPI.git#main
DEEPSEEK_REPO=https://github.com/izaart95-jpg/DeepSeekFreeAPI.git#main
FLARESOLVERR_REPO=https://github.com/Rorqualx/flaresolverr-go.git#main
QWEN2API_REPO=https://github.com/XxxXTeam/Qwen2API_Go.git#main
FLARESOLVERR_REPO=ttps://github.com/Rorqualx/flaresolverr-go.git#main

# ---- FlareSolverr (sidecar, ghcr.io/flaresolverr/flaresolverr) ----
FLARESOLVERR_PORT=8191
FLARESOLVERR_LOG_LEVEL=info
FLARESOLVERR_LOG_HTML=false
FLARESOLVERR_CAPTCHA_SOLVER=none

# ── Qwen2API ──────────────────────────────────────────────────────────────────
QWEN2API_PORT=3006
QWEN2API_PROXY_PORT=2006
QWEN2API_KEY=Waguri
