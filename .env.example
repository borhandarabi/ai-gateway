# ── Cloudflare Tunnel (optional) ─────────────────────────────────────────────
# Leave both unset to disable the tunnel entirely (cloudflared stays installed
# but idle). TUNNEL_ONLY only takes effect when TUNNEL_TOKEN is also set.
TUNNEL_TOKEN=
TUNNEL_ONLY=false

# ── OmniRoute ────────────────────────────────────────────────────────────────
OMNIROUTE_PORT=20128
# (add OmniRoute's own provider/token-related env vars here as needed)

# ── MimoApi ──────────────────────────────────────────────────────────────────
MIMO_PORT=3003

# ── KimiApi ──────────────────────────────────────────────────────────────────
KIMI_PORT=3002
KIMI_ACCESS_TOKEN=
KIMI_AUTH_KEY=Waguri

# ── DeepSeekApi ───────────────────────────────────────────────────────────────
DEEPSEEK_PORT=3005
DEEPSEEK_TOKEN=Waguri

# ── zai-api / GlmApi ─────────────────────────────────────────────────────────
ZAI_PORT=3001
ZAI_AUTH_TOKEN=Waguri
ZAI_TIMEOUT=300000
ZAI_TOKEN=
ZAI_AGENT_MODE=true
ZAI_LOG_LEVEL=info
ZAI_LOG_FORMAT=text

# ── grok2api-go ──────────────────────────────────────────────────────────────
GROK2API_PORT=3004
TZ=Asia/Shanghai
# GROK2API_CONFIG_SOURCE defaults to /data/grok2api/config.yaml (see s6-rc.d/grok2api/run)

# ── mihomo ────────────────────────────────────────────────────────────────────
CLASH_API_PORT=9090
MIXED_PORT=7890

# ── build-time source pins (used by docker-compose.yml / GH Actions) ────────
# OmniRoute is a prebuilt base image, not built from source
OMNIROUTE_IMAGE=diegosouzapw/omniroute:3.8.49-web
MIMO_REPO=https://github.com/hooshidev3/mimo-ai-proxy.git#main

GROK2API_REPO=https://github.com/chenyme/grok2api.git#main
ZAI_REPO=https://github.com/izaart95-jpg/GLM-Free-API.git#main
KIMI_REPO=https://github.com/izaart95-jpg/KimiFreeAPI.git#main
DEEPSEEK_REPO=https://github.com/izaart95-jpg/DeepSeekFreeAPI.git#main

# ---- FlareSolverr (sidecar, ghcr.io/flaresolverr/flaresolverr) ----
FLARESOLVERR_PORT=8191
FLARESOLVERR_LOG_LEVEL=info
FLARESOLVERR_LOG_HTML=false
FLARESOLVERR_CAPTCHA_SOLVER=none
# ترافیک مرورگر داخل FlareSolverr از mixed-port سینگ‌باکس (2006) داخل
# کانتینر ai-gateway رد میشه -- یعنی همون تونلی که بقیهٔ سرویس‌ها دارن.
# برای غیرفعال کردن پروکسی، این مقدار رو خالی بذار: FLARESOLVERR_PROXY_URL=
FLARESOLVERR_PROXY_URL=socks5://ai-gateway:2006
