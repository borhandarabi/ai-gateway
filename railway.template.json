{
  "services": {
    "7f0b7e9e-2e6d-4d0c-9f12-0f3e8d6a1b21": {
      "name": "ai-gateway",
      "source": { "image": "ghcr.io/borhandarabi/ai-gateway:latest" },
      "deploy": {
        "healthcheckPath": "/",
        "healthcheckTimeout": 30,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 5
      },
      "networking": { "tcpProxies": {}, "serviceDomains": { "": {} } },
      "variables": {
        "PORT": { "defaultValue": "80", "isOptional": false, "description": "Railway HTTP port; the gateway reverse proxy listens on port 80." },
        "PROXY_PORT": { "defaultValue": "80", "isOptional": false, "description": "Gateway reverse-proxy listen port." },
        "API_PORT": { "defaultValue": "5000", "isOptional": false, "description": "Internal gateway manager API port." },
        "BIND_ADDR": { "defaultValue": "0.0.0.0", "isOptional": false, "description": "Listen on all Railway interfaces." },
        "TUNNEL_TOKEN": { "defaultValue": "", "isOptional": true, "description": "Optional Cloudflare Tunnel token." },
        "TUNNEL_ONLY": { "defaultValue": "false", "isOptional": false, "description": "Bind app services locally when a tunnel token is configured." },
        "SINGBOX_VERSION": { "defaultValue": "1.13.16", "isOptional": false, "description": "sing-box version used by the bundled manager." },
        "CLASH_API_PORT": { "defaultValue": "9090", "isOptional": false, "description": "sing-box control API port." },
        "MIXED_PORT": { "defaultValue": "7890", "isOptional": false, "description": "sing-box mixed proxy port." },
        "CLASH_SECRET": { "defaultValue": "", "isOptional": true, "description": "Optional token for the sing-box and gateway management APIs." },
        "OMNIROUTE_PROXY_PORT": { "defaultValue": "20129", "isOptional": false, "description": "Outbound proxy port reserved for OmniRoute." },
        "OMNIROUTE_BASE_URL": { "defaultValue": "http://${{omniroute.RAILWAY_PRIVATE_DOMAIN}}:20128", "isOptional": false, "description": "Private URL used by ai-gateway to manage OmniRoute." },
        "OMNIROUTE_MANAGEMENT_API_KEY": { "defaultValue": "", "isOptional": true, "description": "OmniRoute management-scoped API key for Add to OmniRoute." },
        "AI_GATEWAY_INTERNAL_BASE_URL": { "defaultValue": "http://${{ai-gateway.RAILWAY_PRIVATE_DOMAIN}}", "isOptional": false, "description": "Private base URL that OmniRoute uses for gateway providers." },
        "ZENFREEAPI_PORT": { "defaultValue": "3008", "isOptional": false, "description": "ZenFreeAPI HTTP port." },
        "ZENFREEAPI_PROXY_PORT": { "defaultValue": "2008", "isOptional": false, "description": "ZenFreeAPI outbound proxy port." },
        "ZEN_STATE_DIR": { "defaultValue": "/data/zenfreeapi", "isOptional": false, "description": "ZenFreeAPI persistent state directory." },
        "ZENFREEAPI_HTTP_PROXY": { "defaultValue": "", "isOptional": true, "description": "Optional ZenFreeAPI HTTP proxy override." },
        "ZENFREEAPI_HTTPS_PROXY": { "defaultValue": "", "isOptional": true, "description": "Optional ZenFreeAPI HTTPS proxy override." },
        "ZENFREEAPI_ALL_PROXY": { "defaultValue": "", "isOptional": true, "description": "Optional ZenFreeAPI all-protocol proxy override." },
        "OPENCODE_ZEN_BASE": { "defaultValue": "https://opencode.ai/zen/v1", "isOptional": false, "description": "OpenCode Zen upstream URL." },
        "OPENCODE_API_KEY": { "defaultValue": "public", "isOptional": false, "description": "OpenCode Zen API key." },
        "OPENCODE_CLIENT": { "defaultValue": "cli", "isOptional": false, "description": "OpenCode client header value." },
        "OPENCODE_USER_AGENT": { "defaultValue": "opencode/0.0.0", "isOptional": false, "description": "OpenCode upstream user agent." },
        "MIMO_PORT": { "defaultValue": "3003", "isOptional": false, "description": "MimoApi HTTP port." },
        "MIMO_CORS_ORIGIN": { "defaultValue": "*", "isOptional": false, "description": "MimoApi CORS origin." },
        "MIMO_API_KEY": { "defaultValue": "", "isOptional": true, "description": "Optional MimoApi client bearer key." },
        "MIMO_PROXY": { "defaultValue": "2003", "isOptional": false, "description": "MimoApi outbound proxy port." },
        "SERVICE_TOKENS": { "defaultValue": "", "isOptional": true, "description": "MimoApi service tokens." },
        "USER_IDS": { "defaultValue": "", "isOptional": true, "description": "MimoApi user IDs." },
        "XIAOMI_CHATBOT_PHS": { "defaultValue": "", "isOptional": true, "description": "MimoApi Xiaomi chatbot identifiers." },
        "KIMI_PORT": { "defaultValue": "3002", "isOptional": false, "description": "Kimi API HTTP port." },
        "KIMI_ACCESS_TOKEN": { "defaultValue": "", "isOptional": true, "description": "Kimi access token; required to enable Kimi." },
        "KIMI_AUTH_KEY": { "defaultValue": "Waguri", "isOptional": false, "description": "Legacy Kimi auth fallback." },
        "KIMI_PROXY": { "defaultValue": "2002", "isOptional": false, "description": "Kimi outbound proxy port." },
        "DEEPSEEK_PORT": { "defaultValue": "3005", "isOptional": false, "description": "DeepSeek API HTTP port." },
        "DEEPSEEK_TOKEN": { "defaultValue": "", "isOptional": true, "description": "DeepSeek token; required to enable DeepSeek." },
        "DEEPSEEK_PROXY": { "defaultValue": "2005", "isOptional": false, "description": "DeepSeek outbound proxy port." },
        "ZAI_PORT": { "defaultValue": "3001", "isOptional": false, "description": "Z.ai API HTTP port." },
        "ZAI_AUTH_TOKEN": { "defaultValue": "", "isOptional": true, "description": "Z.ai client auth token." },
        "ZAI_TIMEOUT": { "defaultValue": "300000", "isOptional": false, "description": "Z.ai request timeout in milliseconds." },
        "ZAI_AGENT_MODE": { "defaultValue": "true", "isOptional": false, "description": "Enable Z.ai agent mode." },
        "ZAI_LOG_LEVEL": { "defaultValue": "info", "isOptional": false, "description": "Z.ai log level." },
        "ZAI_LOG_FORMAT": { "defaultValue": "text", "isOptional": false, "description": "Z.ai log format." },
        "ZAI_PROXY_PORT": { "defaultValue": "2001", "isOptional": false, "description": "Z.ai outbound proxy port." },
        "ZAI_COLLECTOR_PROXY_PORT": { "defaultValue": "2007", "isOptional": false, "description": "Z.ai token collector proxy port." },
        "GROK2API_PORT": { "defaultValue": "3004", "isOptional": false, "description": "Grok2API HTTP port." },
        "GROK2API_KEY": { "defaultValue": "", "isOptional": true, "description": "Optional Grok2API bootstrap encryption key." },
        "GROK2API_SECRET": { "defaultValue": "", "isOptional": true, "description": "Optional Grok2API bootstrap JWT secret." },
        "TZ": { "defaultValue": "Asia/Shanghai", "isOptional": false, "description": "Timezone used by Grok2API." },
        "FLARESOLVERR_PORT": { "defaultValue": "8191", "isOptional": false, "description": "FlareSolverr HTTP port." },
        "FLARESOLVERR_PROXY_PORT": { "defaultValue": "8190", "isOptional": false, "description": "FlareSolverr outbound proxy port." },
        "FLARESOLVERR_LOG_LEVEL": { "defaultValue": "info", "isOptional": false, "description": "FlareSolverr log level." },
        "FLARESOLVERR_LOG_HTML": { "defaultValue": "false", "isOptional": false, "description": "FlareSolverr HTML logging flag." },
        "FLARESOLVERR_HEADLESS": { "defaultValue": "true", "isOptional": false, "description": "Run FlareSolverr headless." },
        "FLARESOLVERR_CAPTCHA_SOLVER": { "defaultValue": "none", "isOptional": false, "description": "FlareSolverr captcha solver adapter." },
        "FLARESOLVERR_BROWSER_POOL_SIZE": { "defaultValue": "1", "isOptional": false, "description": "FlareSolverr browser pool size." },
        "FLARESOLVERR_BROWSER_POOL_TIMEOUT": { "defaultValue": "30s", "isOptional": false, "description": "FlareSolverr browser pool timeout." },
        "FLARESOLVERR_MAX_MEMORY_MB": { "defaultValue": "1024", "isOptional": false, "description": "FlareSolverr browser memory limit." },
        "FLARESOLVERR_SESSION_TTL": { "defaultValue": "30m", "isOptional": false, "description": "FlareSolverr session lifetime." },
        "FLARESOLVERR_SESSION_CLEANUP_INTERVAL": { "defaultValue": "1m", "isOptional": false, "description": "FlareSolverr session cleanup interval." },
        "FLARESOLVERR_MAX_SESSIONS": { "defaultValue": "100", "isOptional": false, "description": "FlareSolverr maximum sessions." },
        "FLARESOLVERR_DEFAULT_TIMEOUT": { "defaultValue": "60s", "isOptional": false, "description": "FlareSolverr default timeout." },
        "FLARESOLVERR_MAX_TIMEOUT": { "defaultValue": "300s", "isOptional": false, "description": "FlareSolverr maximum timeout." },
        "FLARESOLVERR_RATE_LIMIT_ENABLED": { "defaultValue": "true", "isOptional": false, "description": "Enable FlareSolverr rate limiting." },
        "FLARESOLVERR_RATE_LIMIT_RPM": { "defaultValue": "60", "isOptional": false, "description": "FlareSolverr requests per minute limit." },
        "QWEN2API_PORT": { "defaultValue": "3006", "isOptional": false, "description": "Qwen2API HTTP port." },
        "QWEN2API_PROXY_PORT": { "defaultValue": "2006", "isOptional": false, "description": "Qwen2API outbound proxy port." },
        "QWEN2API_KEY": { "defaultValue": "", "isOptional": true, "description": "Qwen2API client API key." },
        "RAILWAY_RUN_UID": { "defaultValue": "0", "isOptional": false, "description": "Run as root so Railway volumes are writable by all bundled services." },
        "ENABLE_FLARESOLVERR": { "defaultValue": "false", "isOptional": true, "description": "Boot FlareSolverr (headless Chromium) at container start; it can also be toggled from the dashboard at runtime. Chromium needs ~400MB+ RAM." },
        "ENABLE_ZENFREEAPI": { "defaultValue": "false", "isOptional": true, "description": "Boot ZenFreeAPI at container start (dashboard toggle also works)." },
        "ENABLE_MIMO": { "defaultValue": "false", "isOptional": true, "description": "Boot MimoApi at container start (dashboard toggle also works)." },
        "ENABLE_ZAI": { "defaultValue": "false", "isOptional": true, "description": "Boot Z.ai API at container start (dashboard toggle also works)." },
        "ZAI_AUTO_COLLECT": { "defaultValue": "false", "isOptional": true, "description": "Let zai-api collect tokens with headless Chromium on first boot when tokens.sqlite is missing. Heavy (~400MB RAM for minutes)." },
        "ENABLE_KIMI": { "defaultValue": "false", "isOptional": true, "description": "Boot Kimi API at container start (needs KIMI_ACCESS_TOKEN; dashboard toggle also works)." },
        "ENABLE_DEEPSEEK": { "defaultValue": "false", "isOptional": true, "description": "Boot DeepSeek proxy at container start (needs DEEPSEEK_TOKEN; dashboard toggle also works)." },
        "ENABLE_GROK2API": { "defaultValue": "false", "isOptional": true, "description": "Boot Grok2API at container start (dashboard toggle also works)." },
        "ENABLE_QWEN2API": { "defaultValue": "false", "isOptional": true, "description": "Boot Qwen2API at container start (dashboard toggle also works)." }
      },
      "volumeMounts": { "7f0b7e9e-2e6d-4d0c-9f12-0f3e8d6a1b21-data": { "mountPath": "/data" } }
    },
    "c8a7d6e5-4f32-4a1b-9c87-6d5e4f3a2b10": {
      "name": "omniroute",
      "source": { "image": "diegosouzapw/omniroute:3.8.50" },
      "deploy": {
        "healthcheckPath": "/api/monitoring/health",
        "healthcheckTimeout": 15,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 5
      },
      "networking": { "tcpProxies": {}, "serviceDomains": { "": {} } },
      "variables": {
        "PORT": { "defaultValue": "20128", "isOptional": false, "description": "OmniRoute HTTP port." },
        "JWT_SECRET": { "defaultValue": "${{secret(64, \"abcdef0123456789\")}}", "isOptional": false, "description": "Fixed secret for OmniRoute sessions; do not change after deployment." },
        "API_KEY_SECRET": { "defaultValue": "${{secret(64, \"abcdef0123456789\")}}", "isOptional": false, "description": "Fixed secret for OmniRoute API keys; do not change after deployment." },
        "INITIAL_PASSWORD": { "defaultValue": "", "isOptional": true, "description": "Optional first-login dashboard password." },
        "REQUIRE_API_KEY": { "defaultValue": "true", "isOptional": false, "description": "Require API keys for internet-facing OmniRoute requests." },
        "RAILWAY_RUN_UID": { "defaultValue": "0", "isOptional": false, "description": "Allow OmniRoute to write its mounted SQLite data volume." }
      },
      "volumeMounts": { "c8a7d6e5-4f32-4a1b-9c87-6d5e4f3a2b10-data": { "mountPath": "/app/data" } }
    }
  }
}
