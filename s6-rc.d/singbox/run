#!/command/with-contenv bash
# Proxy kernel: TUN + SOCKS/HTTP mixed-port + control API, both active per config.
# Runtime note: this process needs CAP_NET_ADMIN/CAP_NET_RAW and /dev/net/tun
# (pass --cap-add=NET_ADMIN --cap-add=NET_RAW --device=/dev/net/tun to `docker run`,
# already wired into docker-compose.yml).
set -e
mkdir -p /data/sing-box

export HOST="${BIND_ADDR:-0.0.0.0}"
export TEMPLATE_FILE="${TEMPLATE_FILE:-/data/sing-box/template.json}"
export NODES_FILE="${NODES_FILE:-/data/sing-box/nodes.json}"
export CONFIG_FILE="${CONFIG_FILE:-/data/sing-box/config.json}"
export STATE_FILE="${STATE_FILE:-/data/sing-box/state.json}"
export CLASH_API_PORT="${CLASH_API_PORT:-9090}"

exec singbox-manager
