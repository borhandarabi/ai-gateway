#!/command/with-contenv bash
set -e
exec 2>&1
cd /opt/zai
export PORT="${ZAI_PORT:-3001}"
export HOST="${BIND_ADDR:-0.0.0.0}"
export TIMEOUT="${ZAI_TIMEOUT:-300000}"
export AUTH_TOKEN="${ZAI_AUTH_TOKEN:-Waguri}"
export AGENT_MODE="${ZAI_AGENT_MODE:-true}"
export LOG_LEVEL="${ZAI_LOG_LEVEL:-info}"
export LOG_FORMAT="${ZAI_LOG_FORMAT:-text}"


export PROXY_SERVER_URL="http://127.0.0.1:${ZAI_PROXY_PORT:-2001}"
export PROXY_COLLECTOR_URL="http://127.0.0.1:${ZAI_COLLECTOR_PROXY_PORT:-2007}"

# Token bootstrap. `zai-api collect` drives a real headless Chromium via
# Playwright -- hundreds of MB of RAM for minutes. On a 1GB container that
# can OOM-kill neighbours, so it only runs when explicitly enabled with
# ZAI_AUTO_COLLECT=true. Without tokens the server still boots; requests
# just fail until tokens exist (collect from a bigger machine and mount
# tokens.sqlite, or flip ZAI_AUTO_COLLECT and restart).
if [ ! -f /data/zai/tokens.sqlite ]; then
    if [ "${ZAI_AUTO_COLLECT:-false}" = "true" ] || [ "${ZAI_AUTO_COLLECT:-false}" = "1" ]; then
        echo "[zai] No tokens.sqlite found; auto-collect enabled, generating tokens (Chromium)..."
        # Not exec: we must copy the produced DB before handing over.
        ./zai-api collect --tokens 750 --batch 1 --no-tui --parallel 1 --db-path="/data/zai/tokens.sqlite"
    else
        echo "[zai] No tokens.sqlite found and ZAI_AUTO_COLLECT != true."
        echo "[zai] Starting WITHOUT tokens; set ZAI_AUTO_COLLECT=true (restart needed) or provide /data/zai/tokens.sqlite."
    fi
fi

# AUTH_TOKEN defaults to the upstream "Waguri" placeholder if unset -- override
# this in production, do not rely on the default.
exec ./zai-api --agent-mode --db-path="/data/zai/tokens.sqlite"
