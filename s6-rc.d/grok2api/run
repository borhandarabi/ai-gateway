#!/command/with-contenv bash
set -e
mkdir -p /data/grok2api
export TZ="${TZ:-Asia/Shanghai}"

# Ensure data dir is writable by grok2api user
chown -R grok2api:grok2api /data/grok2api/
chmod 755 /data/grok2api/

# Generate config if missing or invalid
if [ ! -f /data/grok2api/config.yaml ]; then
  echo "[grok2api] No config found, generating default..."
  KEY=$(head -c 32 /dev/urandom | base64)
  cat > /data/grok2api/config.yaml << EOF
server:
  listen: ":${GROK2API_PORT:-8000}"

secrets:
  jwtSecret: "ai-gateway-default-jwt-secret-change-me-in-production-32chars"
  credentialEncryptionKey: "${KEY}"

bootstrapAdmin:
  username: admin
  password: admin123456
EOF
  chown grok2api:grok2api /data/grok2api/config.yaml
  chmod 0600 /data/grok2api/config.yaml
fi

# NOTE: We bypass the upstream grok2api-entrypoint because it copies config
# to /app/config.yaml which conflicts with OmniRoute's /app directory.
# Instead we run grok2api directly as the grok2api user via su-exec.
cd /opt/grok2api
exec su-exec grok2api:grok2api /opt/grok2api/grok2api \
  --config "/data/grok2api/config.yaml"
