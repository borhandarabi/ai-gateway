#!/command/with-contenv bash
set -e
exec 2>&1
mkdir -p /data/grok2api
mkdir -p /data/grok2api/media
export TZ="${TZ:-Asia/Shanghai}"

# Ensure data dir is writable by grok2api user
chown -R grok2api:grok2api /data/grok2api/
chmod 755 /data/grok2api/

if [ -f /data/grok2api/config.yaml ]; then
  mv -f /data/grok2api/config.yaml /data/grok2api/config.yaml.bak
fi

# Generate config if missing or invalid
if [ ! -f /data/grok2api/config.yaml ]; then
  echo "[grok2api] No config found, generating default..."
  KEY="${GROK2API_KEY:-$(head -c 32 /dev/urandom | base64)}"
  SECRET="${GROK2API_SECRET:-$(head -c 32 /dev/urandom | base64)}"
  cat > /data/grok2api/config.yaml << EOF
server:
  listen: "${BIND_ADDR:-0.0.0.0}:${GROK2API_PORT:-3004}"
  maxBodyBytes: 33554432
  readTimeout: 15m
  requestTimeout: 2h
  swaggerEnabled: false

auth:
  accessTokenTTL: 15m
  refreshTokenTTL: 720h
  secureCookies: false


secrets:
  jwtSecret: "${SECRET}"
  credentialEncryptionKey: "${KEY}"

bootstrapAdmin:
  username: admin
  password: admin123456

frontend:
  staticPath: "/opt/grok2api/frontend/dist"

qualityGuard:
  enabled: true
  model: "grok-4.5"
  mode: hybrid # passive | active | hybrid
  activeInterval: 30m
  passivePollInterval: 5s
  softTPS: 500
  hardTPS: 1000
  consecutiveSoft: 2
  consecutiveErrors: 2
  quarantineDuration: 5m
  noAccountBackoff: 5m
  minimumHealthyNodes: 3
  maxOutputTokens: 384
  failClosed: false
  minimumGenerationWindow: 1s
  rotationURL: ""
  rotationToken: ""
  rotationTimeout: 45s
  nodeIDs: []
  rotatableNodeIDs: []

database:
  driver: sqlite # sqlite | postgres
  sqlite:
    path: "/data/grok2api/backend.db"
  postgres:
    dsn: "postgres://user:password@127.0.0.1:5432/grok2api?sslmode=disable"
    maxOpenConns: 50
    maxIdleConns: 10

runtimeStore:
  driver: memory # memory | redis
  redis:
    address: "127.0.0.1:6379"
    username: ""
    password: ""
    database: 0
    keyPrefix: "grok2api:"
    tls: false

deployment:
  replicas: 1
  instanceID: ""
  clusterID: "grok2api"
  sharedMedia: false

media:
  driver: local
  local:
    path: "/data/grok2api/media"

routing:
  reasoningReplayEnabled: true
  reasoningReplayTTL: 1h
  reasoningReplayMaxEntries: 10240
  segmentedSelectorEnabled: false
  segmentedSelectorMinCandidates: 3000
  segmentedSelectorWindowSize: 64

audit:
  bufferSize: 16384
  batchSize: 256
  flushInterval: 250ms
  commitDelay: 5ms
  ledgerMode: enforce # observe | enforce
  ledgerFailureThreshold: 1
  ledgerUnhealthyGrace: 10s
  ledgerQueueHighWatermarkPercent: 90

EOF
  chown grok2api:grok2api /data/grok2api/config.yaml
  chmod 0600 /data/grok2api/config.yaml
fi

# NOTE: We bypass the upstream grok2api-entrypoint because it copies config
# to /app/config.yaml which conflicts with OmniRoute's /app directory.
# Instead we run grok2api directly as the grok2api user via su-exec.
cd /opt/grok2api
exec su-exec grok2api:grok2api /opt/grok2api/grok2api --config "/data/grok2api/config.yaml"
