#!/command/with-contenv bash
set -e
exec 2>&1
cd /opt/mimo
mkdir -p /data/mimo
# NOTE (open item): MimoApi's own source wasn't inspected for a HOST/bind-address
# env var. If main.go hardcodes 0.0.0.0, TUNNEL_ONLY's 127.0.0.1 mode will not
# actually apply to this service until that's confirmed/patched upstream.
export PORT="${MIMO_PORT:-3003}"
export HOST="${BIND_ADDR:-0.0.0.0}"
export CORS_ORIGIN="${MIMO_CORS_ORIGIN:-*}"
export SERVICE_TOKENS="${SERVICE_TOKENS}"
export USER_IDS="${USER_IDS}"
export XIAOMI_CHATBOT_PHS="${XIAOMI_CHATBOT_PHS}"
# Client-facing bearer key for this service's own /v1/chat/completions
# (mimo-ai-proxy's own middleware/auth.go: only enforced when non-empty).
# Not set by default -- same "open unless configured" default as most other
# services in this image.
export API_KEY="${MIMO_API_KEY:-}"


export HTTP_PROXY="socks5h://127.0.0.1:${MIMO_PROXY:-2003}"
export HTTPS_PROXY="socks5h://127.0.0.1:${MIMO_PROXY:-2003}"
export ALL_PROXY="socks5h://127.0.0.1:${MIMO_PROXY:-2003}"
export NO_PROXY="localhost,127.0.0.1"


exec ./mimoproxy
