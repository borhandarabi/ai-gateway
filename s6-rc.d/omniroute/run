#!/command/with-contenv bash
set -e
cd /opt/omniroute
export PORT="${OMNIROUTE_PORT:-20128}"
export HOSTNAME="${BIND_ADDR:-0.0.0.0}"
export NODE_ENV=production
export DATA_DIR=/data/omniroute
export OMNIROUTE_MIGRATIONS_DIR=/opt/omniroute/migrations
mkdir -p "${DATA_DIR}"
exec node dev/run-standalone.mjs
