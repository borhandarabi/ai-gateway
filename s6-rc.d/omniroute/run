#!/command/with-contenv bash
set -e
exec 2>&1
export DATA_DIR="${DATA_DIR:-/data/omniroute}"
export PORT="${OMNIROUTE_PORT:-20128}"
export HOSTNAME="${BIND_ADDR:-0.0.0.0}"
mkdir -p "${DATA_DIR}"
chown -R node:node "${DATA_DIR}"
cd /app
# OmniRoute's own published image's real ENTRYPOINT+CMD, run as-is (extracted
# from the actual published artifact, not reimplemented). Its last USER layer
# is `node` (non-root) -- we run as root at the container level (s6 needs
# that), so drop to `node` explicitly here with su-exec to match upstream's
# intended privilege level, same pattern as the grok2api service.
exec su-exec node /tmp/check-permissions.sh node dev/run-standalone.mjs
