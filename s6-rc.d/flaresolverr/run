#!/command/with-contenv bash
set -e
export HOST="${BIND_ADDR:-0.0.0.0}"
export PORT="${FLARESOLVERR_PORT:-8191}"
export LOG_LEVEL="${FLARESOLVERR_LOG_LEVEL:-info}"
export LOG_HTML="${FLARESOLVERR_LOG_HTML:-false}"
export HEADLESS="${FLARESOLVERR_HEADLESS:-false}"
export BROWSER_POOL_SIZE="${FLARESOLVERR_BROWSER_POOL_SIZE:-3}"
export BROWSER_POOL_TIMEOUT="${FLARESOLVERR_BROWSER_POOL_TIMEOUT:-30s}"
export MAX_MEMORY_MB="${FLARESOLVERR_MAX_MEMORY_MB:-2048}"
export SESSION_TTL="${FLARESOLVERR_SESSION_TTL:-30m}"
export SESSION_CLEANUP_INTERVAL="${FLARESOLVERR_SESSION_CLEANUP_INTERVAL:-1m}"
export MAX_SESSIONS="${FLARESOLVERR_MAX_SESSIONS:-100}"
export DEFAULT_TIMEOUT="${FLARESOLVERR_DEFAULT_TIMEOUT:-60s}"
export MAX_TIMEOUT="${FLARESOLVERR_MAX_TIMEOUT:-300s}"
export RATE_LIMIT_ENABLED="${FLARESOLVERR_RATE_LIMIT_ENABLED:-true}"
export RATE_LIMIT_RPM="${FLARESOLVERR_RATE_LIMIT_RPM:-60}"
export BROWSER_PATH="/usr/bin/chromium"

export DISPLAY=":99"
export LIBGL_ALWAYS_SOFTWARE="1"
export GALLIUM_DRIVER="llvmpipe"
export LP_NUM_THREADS="4"

if [ "$HEADLESS" = "false" ]; then
    echo "[flaresolverr] Starting Xvfb on :99..."
    /usr/local/bin/su-exec flaresolverr:flaresolverr Xvfb :99 -screen 0 1920x1080x24 -ac &
    sleep 1
    if ! pgrep -x Xvfb > /dev/null; then
        echo "ERROR: Failed to start Xvfb"
        exit 1
    fi
fi

exec /usr/local/bin/su-exec flaresolverr:flaresolverr /opt/flaresolverr/flaresolverr
