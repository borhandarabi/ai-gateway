#!/command/with-contenv bash
# Proxy kernel: TUN + SOCKS/HTTP mixed-port + control API, both active per config.
# Runtime note: this process needs CAP_NET_ADMIN/CAP_NET_RAW and /dev/net/tun
# (pass --cap-add=NET_ADMIN --cap-add=NET_RAW --device=/dev/net/tun to `docker run`,
# already wired into docker-compose.yml).
set -e
mkdir -p /data/mihomo
if [ ! -f /data/mihomo/config.yaml ]; then
  if [ "${DISABLE_TUN:-false}" = "true" ]; then
    echo "[mihomo] DISABLE_TUN=true -- seeding no-TUN config (mixed-port only)"
    echo "[mihomo] this is required on platforms without CAP_NET_ADMIN/TUN device access, e.g. Railway"
    cp /data/mihomo/config.no-tun.yaml.default /data/mihomo/config.yaml
  else
    echo "[mihomo] no /data/mihomo/config.yaml found, seeding default (TUN + mixed-port)"
    cp /data/mihomo/config.yaml.default /data/mihomo/config.yaml
  fi
fi
exec mihomo -d /data/mihomo -f /data/mihomo/config.yaml
